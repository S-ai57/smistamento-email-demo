# Copia questo file in .env (stessa cartella) e compila i valori.
# Il file .env resta SOLO sul tuo computer: non condividerlo mai,
# non finisce in un archivio della demo e non finisce nel codice.
#
# Gateway OpenAI-compatibile a cui il BFF chiede di leggere i messaggi.
AI_BASE_URL=https://models.galene.ai/v1
# Chiave del gateway: MAI nel codice, MAI nel frontend.
AI_API_KEY=inseri…ave
# Modello da usare (deve essere abilitato sul gateway).
AI_MODEL=Galene/DeepSeek-V4-Flash
# Porta locale del BFF (ascolta solo su 127.0.0.1).
AI_PORT=8787
